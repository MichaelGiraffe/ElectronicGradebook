<h1>Создание документа защиты</h1>


<%= form_with url: conference_path, method: :post do %>

    <%= select_tag :document_type,
    options_for_select([
        "ГОСТ",
        "Протокол ГЭК"
    ],@document_type) %>
    <br></br>
    <%= select_tag :kind,
    options_for_select([
        "бакалавр",
        "магистр"
    ],@kind) %>

    <p>ФИО студента: <%= text_field_tag :fio, @fio %></p>
    <p>Код направления: <%= text_field_tag :code, @code %></p>
    <p>Наименование направления: <%= text_field_tag :codename, @codename %></p>
    <p>Профиль(направленность): <%= text_field_tag :profile, @profile %></p>
    <p>Тема: <%= text_field_tag :theme, @theme %></p>
    <p>Количество страниц ВКР: <%= number_field_tag :main_list, @main_list %></p>
    <p>Количество страниц приложений: <%= number_field_tag :add_list, @add_list %></p>
    <p>Оценка: <%= number_field_tag :grade, @grade %></p>

    <p>Председатель: <%= text_field_tag :host, @host %></p>
    <p>Член ГЭК: <%= text_field_tag :GAK1, @GAK1 %></p>
    <p>Член ГЭК: <%= text_field_tag :GAK2, @GAK2 %></p>
    <p>Член ГЭК: <%= text_field_tag :GAK3, @GAK3 %></p>
    <p>Секретарь ГЭК: <%= text_field_tag :secretary, @secretary %></p>

    <p>Научный руководитель: <%= text_field_tag :teacher, @teacher %></p>
    <p>Консультант: <%= text_field_tag :helper, @helper %></p>

    <%= submit_tag "Создать документ" %>
<% end %>



<br>
    <hr>
    <h2>Предпросмотр документа</h2>
    <hr>
</br>


<% case @document_type %>
<% when "ГОСТ" %>
    <%#= Time.now.year %>
    <b><center>№ Бланка __ (тут как вариант можно поставить id студента+n (костыль))</center></b>
    <p align="right">Дата заседания ГЭК «<%= Time.now.day %>» <%= Time.now.strftime("%B") %> <%= Time.now.year %> г.</p>
    <ol>
        <b><li> ФИО ЗАЩИЩАЮЩЕГОСЯ (в родительном падеже) </li></b>
        <%= @fio %>
        <b><li> ТЕМА ВЫПУСКНОЙ КВАЛИФИКАЦИОННОЙ РАБОТЫ </li></b>
        <%= @theme %>

        <b><li> СОСТАВ ГОСУДАРСТВЕННОЙ ЭКЗАМЕНАЦИОННОЙ КОМИССИИ (ГЭК) </li></b>
        <%# тут таблица %>
        <table>
            <%# заголовки %>
            <thead>
                <tr>
                    <th>Статус</th>
                    <th>ФИО</th>
                </tr>
            </thead>
            <%# ячейки %>
            <tbody>

                <tr>
                    <td>Председатель</td>
                    <td><%= @host %></td>
                </tr>

                <tr>
                    <td>Член ГЭК</td>
                    <td><%= @GAK1 %></td>
                </tr>

                <tr>
                    <td>Член ГЭК</td>
                    <td><%= @GAK2 %></td>
                </tr>

                <tr>
                    <td>Член ГЭК</td>
                    <td><%= @GAK3 %></td>
                </tr>

                <tr>
                    <td>Секретарь ГЭК</td>
                    <td><%= @secretary %></td>
                </tr>
            </tbody>
        </table>

        <b><li> РУКОВОДИТЕЛЬ И КОНСУЛЬТАНТ ВКР </li></b>
        <%# тут таблица %>
        <table>
            <%# заголовки %>
            <thead>
                <tr>
                    <th></th>
                    <th>ФИО</th>
                    <th>Должность</th>
                    <th>Ученая степень, звание</th>
                </tr>
            </thead>

            <%# ячейки %>
            <tbody>
                <tr>
                    <td>Председатель</td>
                    <td><%= @teacher %></td>
                    <td>...</td>
                    <td>...</td>
                </tr>

                <tr>
                    <td>Председатель</td>
                    <td><%= @helper %></td>
                    <td>...</td>
                    <td>...</td>
                </tr>
            </tbody>
        </table>

        <b><li> ОБЪЁМ РАБОТЫ </li></b>
        <%# тут таблица %>
        <table>
            <%# ячейки %>
            <tbody>
                <tr>
                    <td>Количество страниц ВКР</td>
                    <td><%= @main_list %></td>
                </tr>

                <tr>
                    <td>Количество страниц приложений</td>
                    <td><%= @add_list %></td>
                </tr>
            </tbody>
        </table>


        <hr>
        <b><center>ОБОРОТНАЯ СТОРОНА БЛАНКА</center></b>
        <b><li> ВОПРОСЫ, ЗАДАННЫЕ ЧЛЕНАМИ ГЭК (реализую с добавлением бд, динамическая таблица!) </li></b>
        <%# тут таблица должна быть динамической, но пока такой возможности нет%>
        <table>
            <%# заголовки %>
            <thead>
                <tr>
                    <th>№</th>
                    <th>Кто задал вопрос</th>
                    <th>Содержание вопроса</th>
                </tr>
            </thead>

            <%# ячейки %>
            <tbody>
                <tr>
                    <td>1</td>
                    <td>ФИО</td>
                    <td>...</td>
                </tr>

                <tr>
                    <td>2</td>
                    <td>ФИО</td>
                    <td>...</td>
                </tr>

                <tr>
                    <td>3</td>
                    <td>ФИО</td>
                    <td>...</td>
                </tr>

                <tr>
                    <td>4</td>
                    <td>ФИО</td>
                    <td>...</td>
                </tr>
            </tbody>
        </table>

        <b><li> ХАРАКТЕРИСТИКА ОТВЕТОВ ЗАЩИЩАЮЩЕГОСЯ (получше узнать как должно быть реализовано) </li></b>
        <u>Что это вообще значит? Тут должны быть ответы которые он сказал или их описание что он молодец ответил на то-то?</u>

        <b><li> РЕШЕНИЕ ГОСУДАРСТВЕННОЙ ЭКЗАМЕНАЦИОННОЙ КОМИССИИ </li></b>
        <table>
            <%# ячейки %>
            <tbody>
                <tr>
                    <td>Оценка за защиту ВКР</td>
                    <td>
                        <input type="checkbox"> отлично
                        <input type="checkbox"> хорошо
                        <input type="checkbox"> удовлетворительно
                        <input type="checkbox"> неудовлетворительно
                    </td>
                </tr>

                <tr>
                    <td>Присвоена квалификация (степень)</td>
                    <td>
                        <input type="checkbox"> бакалавр
                        <input type="checkbox"> магистр
                    </td>
                </tr>

                <tr>
                    <td>Направление подготовки</td>
                    <td><%= @code %>, <%= @codename %></td>
                </tr>

                <tr>
                    <td>Профиль (направленность)</td>
                    <td><%= @profile %></td>
                </tr>
                    <td>Диплом</td>
                    <td>
                    <input type="checkbox"> с отличием
                    <input type="checkbox"> без отличия
                    </td>
                <tr>

                </tr>
            </tbody>
        </table>
    </ol>

    <br>
    <pre>
        Председатель ГЭК: _______________________ /______________________/
                                        (подпись)                           (ФИО)

        Секретарь ГЭК:    _______________________ /______________________/
                                        (подпись)                           (ФИО)
    </pre>
    <pre>
        Дата: «<%= Time.now.day %>» <%= Time.now.strftime("%B") %> <%= Time.now.year %> г.
    </pre>

    <%= link_to "Скачать Word", download_document_path %>
    </div>

<% when "Протокол ГЭК"%>
    <center>
        <h1>ПРОТОКОЛ №_______</h1>
        <h1>заседания Государственной экзаменационной комиссии ФГАОУ ВО «МГТУ «СТАНКИН»</h1>
    </center>
    <br></br>
    <p align="right">«<%= Time.now.day %>» <%= Time.now.strftime("%B") %> <%= Time.now.year %> г.</p>
    <p>по рассмотрению выпускной квалификационной работы <%= @fio %></p>
    <p>на тему <%= @theme %></p>

    <center><h2><i>ПРИСУТСТВОВАЛИ:</i></h2></center>
    <p>председатель ГЭК: <%= @host %></p>
    <p>члены ГЭК: <%= @GAK1 %>, <%= @GAK2 %>, <%= @GAK3 %>, <%= @secretary %></p>

    <center><h2><i>ВЫПУСКНАЯ КВАЛИФИКАЦИОННАЯ РАБОТА ВЫПОЛНЕНА</i></h2></center>
    <p>под руководством: <%= @teacher %></p>
    <p>при консультации: <%= @helper %></p>

    <center><h2><i>В ГЭК ПРЕДСТАВЛЕНЫ СЛЕДУЮЩИЕ МАТЕРИАЛЫ:</i></h2></center>
    <ol>
         <li>Выпускная квалификационная работа на <%= @main_list %> листах;</li>
         <li>Приложения к ВКР на <%= @add_list %> листах;</li>
         <li>Отзыв руководителя ВКР;</li>
         <li>Рецензия на ВКР.</li>
    </ol>

    <br>
    <hr></hr>
    </br>

    <p>После сообщения о выполненной ВКР обучающемуся были заданы следующие вопросы: _____________________________ </p>
    <p>Общая характеристика ответов на заданные вопросы: _____________________________</p>

    <center><h2><i>РЕШЕНИЕ ГЭК</i></h2></center>
    <p>Признать, что обучающийся освоил(а) все компетенции, предусмотренные ОП ВО, выполнил(а) и защитил(а) выпускную квалификационную работу</p>
    <p align="right">с оценкой: <%= @grade %> </p>
    <p>Присвоить <%= @fio %></p>
    <p>квалификацию <%= if @kind=="магистр" then "магистра" else "бакалавра" end %> по направлению подготовки <%= @code %> <%= @codename %> </p>
    <p>Особые мнения членов комиссии _____________________________</p>
    <p>Отметить, что _____________________________</p>
    <p>Выдать диплом Государственного образца (с отличием, без отличия)  _____________________________ <%#= case @grade.to_i when 45..54 then "отлично" when 35..44 then "хорошо" when 25..34 then "удовлетворительно" when 0..24 then "неудовлетворительно" else "проверьте число" end %> </p>
    
    <br></br>
    <pre>Председатель   _____________________________                           _____________________________</pre>
    <br></br>
    <pre>Секретарь         _____________________________                           _____________________________</pre>
    <br></br>
    <%= link_to "Скачать Word", download_document_path %>
<% end %>





<%# эта команда может рано или поздно помочь %>
<%#= case @grade.to_i when 45..54 then "отлично" when 35..44 then "хорошо" when 25..34 then "удовлетворительно" when 0..24 then "неудовлетворительно" else "проверьте число" end %>