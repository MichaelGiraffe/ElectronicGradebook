<h1>Редактирование профиля</h1>

<%= form_with model: @user, url: profile_path, method: :patch do |f| %>
    <div>
        <%= f.label :last_name, "Фамилия" %>
        <br>
        <%= f.text_field :last_name %>
    </div>

    <div>
        <%= f.label :first_name, "Имя" %>
        <br>
        <%= f.text_field :first_name %>
    </div>

    <div>
        <%= f.label :patronymic, "Отчество" %>
        <br>
        <%= f.text_field :patronymic %>
    </div>

    <div>
        <%= f.label :email, "Email" %>
        <br>
        <%= f.email_field :email %>
    </div>

    <div>
        <%= f.label :about, "О себе" %>
        <br>
        <%= f.text_area :about, rows: 5 %>
    </div>

    <div>
        <%= f.label :password, "Новый пароль" %>
        <br>
        <%= f.password_field :password, autocomplete: "new-password" %>
    </div>

    <div>
        <%= f.label :password_confirmation, "Подтверждение пароля" %>
        <br>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>

    <%= f.submit "Сохранить изменения", class: "btn-submit" %>
<% end %>
