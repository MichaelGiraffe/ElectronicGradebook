<div class="auth-form">
  <h2 style="text-align: center; margin-bottom: 20px;">Регистрация</h2>

  <%= form_with scope: :user, url: register_path, method: :post, local: true do |f| %>

    <%= f.label :last_name, "Фамилия:" %>
    <%= f.text_field :last_name, placeholder: "Иванов", required: true %>

    <%= f.label :first_name, "Имя:" %>
    <%= f.text_field :first_name, placeholder: "Иван", required: true %>

    <%= f.label :patronymic, "Отчество:" %>
    <%= f.text_field :patronymic, placeholder: "Иванович" %>

    <%= f.label :email, "Электронная почта:" %>
    <%= f.email_field :email, placeholder: "E-mail", required: true %>

    <%= f.label :password, "Пароль:" %>
    <%= f.password_field :password, placeholder: "Введите пароль", required: true %>

    <%= f.label :password_confirmation, "Подтвердите пароль:" %>
    <%= f.password_field :password_confirmation, placeholder: "Повторите пароль", required: true %>

    <div class="checkbox-group" style="margin: 15px 0; display: flex; align-items: flex-start; gap: 10px;">
      <%= f.check_box :policy, required: true, id: "policy" %>
      <label for="policy" style="font-size: 13px; line-height: 1.4;">
        Я подтверждаю согласие на <strong>обработку персональных данных</strong> и принимаю
        <%= link_to "политику конфиденциальности", "#" %>
      </label>
    </div>

    <%= f.button "Создать аккаунт", type: :submit, class: "btn-submit", style: "width: 100%;" %>

  <% end %>
</div>