<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Золотая Середина - Туристическое агентство</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "pages", "data-turbo-track": "reload" %>
</head>
<body>
    <div class="container">
        <header>
            <div class="header-content">
                <div class="flag"><%= image_tag "russia_flag.png", alt: "Россия", class: "flag-logo" %></div>
                <div class="site-title">
                    <h1>Электронный журнал защит</h1>
                </div>
                <div class="login-form">
                    <% if session[:user_id] %>
                        <span style="font-size: 14px;">Привет, <%= User.find(session[:user_id]).username %>!</span>
                        <a href="/cart" style="margin-left: 10px; font-weight: bold; color: #ff8c00;">Корзина (<%= session[:cart]&.count || 0 %>)</a>
                        <a href="/profile">Личный кабинет</a>
                        <%= link_to "Выйти", logout_path, data: { "turbo-method": :delete }, style: "font-size: 12px; color: red;" %>
                    <% else %>
                        <form action="/login" method="post">
                            <input type="text" name="login" placeholder="Логин">
                            <input type="password" name="password" placeholder="Пароль">
                            <input type="submit" value="Войти">
                        </form>
                        <a href="/register" style="font-size: 12px; color: #0000ee; margin-top: 5px;">Регистрация</a>
                    <% end %>
                </div>
            </div>
        </header>

        <nav>
            <div class="main-menu">
                <div class="menu-links">
                    <a href="/">Главная</a>
                    <a href="/conference">Создать конференцию</a>
                    <a href="/accounts">Создать участника</a>
                    <a href="/contacts">Техподдержка</a>
                </div>
                <form class="search-form" action="/search" method="get">
                    <input type="text" placeholder="Найти конференцию" name="search">
                    <input type="submit" value="Найти">
                </form>
            </div>
        </nav>

        <div class="content">
            <div class="main-content">
            
                <%# Сюда будет подставляться контент из конкретных страниц %>
                <%= yield %>

                <footer>
                    © <%= Time.now.year %> МГТУ «СТАНКИН». Все права защищены.
                </footer>
            </div>
        </div>
    </div>
</body>
</html>
