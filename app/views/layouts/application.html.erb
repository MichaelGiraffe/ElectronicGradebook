<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Электронный журнал защит</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "pages", "data-turbo-track": "reload" %>
</head>
<body>
    <div class="container">
        <header>
            <div class="header-content">
                <div class="flag"><%= image_tag "russia_flag.png", alt: "Россия", class: "flag-logo" %></div>
                <div class="site-title">
                    <h1>Электронный журнал защит</h1>
                </div>
                <div class="login-form">
                    <% if session[:user_id] %>
                        <span style="font-size: 14px;">Привет, <%= current_user.first_name %>!</span>
                        <a href="/profile">Личный кабинет</a>
                        <%= button_to "Выйти", logout_path, method: :delete %>
                    <% else %>
                        <%= form_with url: login_path, method: :post, local: true do |f| %>
                            <%= f.email_field :email, placeholder: "Email" %>
                            <%= f.password_field :password, placeholder: "Пароль" %>
                            <%= f.submit "Войти" %>
                        <% end %>
                        <%= link_to "Регистрация", register_path, style: "font-size: 12px; color: #0000ee; margin-top: 5px;" %>
                    <% end %>
                </div>
            </div>
        </header>

        <nav>
            <div class="main-menu">
                <div class="menu-links">
                    <a href="/">Главная</a>
                    <a href="/conference">Создать отчет</a>
                    <a href="/add_conference">Добавить конференцию</a>
                    <a href="/import_students">Импорт студентов</a>
                    <a href="/contacts">Техподдержка</a>
                </div>
                <form class="search-form" action="/search" method="get">
                    <input type="text" placeholder="Найти конференцию" name="search">
                    <input type="submit" value="Найти">
                </form>
            </div>
        </nav>

        <div class="content">
            <div class="main-content">
            
                <%# Сюда будет подставляться контент из конкретных страниц %>
                <%= yield %>

                <footer>
                    © <%= Time.now.year %> МГТУ «СТАНКИН». Все права защищены.
                </footer>
            </div>
        </div>
    </div>
</body>
</html>
